{
  "name": "changelog-editor",
  "version": "1.1.0",
  "description": "A developer-friendly tool for managing changelogs",
  "author": "Nuno Silva",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.nunosilva.changelogeditor",
    "productName": "Changelog Editor",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "publish": {
    "provider": "github",
    "vPrefixedTagName": false
  },
  "generateUpdatesFilesForAllChannels": false,
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "marked": "^17.0.1",
    "tailwindcss": "^4.1.18"
  }
}